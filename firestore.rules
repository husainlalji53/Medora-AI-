rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Prescriptions subcollection
      match /prescriptions/{prescriptionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(prescriptionId) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(prescriptionId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Daily dose logs subcollection
      match /dailyDoseLogs/{dateId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(dateId) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(dateId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
